# Copy to .env and fill in. .env is gitignored (.gitignore:5); NEVER commit it.
#   set -a && . ./.env && set +a

# ---------------------------------------------------------------- NAS (SMB)
# Sample storage. Consumed by empirical_types/nas.py and the ops/qemu tooling.
PACKER_NAS_USERNAME=
PACKER_NAS_PASSWORD=

# ------------------------------------------------------- MalwareBazaar API
# Free for not-for-profit use under abuse.ch fair-use terms; get a key at
# https://auth.abuse.ch/ . Query volume limits are unpublished and enforced at
# abuse.ch's discretion; file downloads are hard-capped at 2,000 per IP per day.
# See docs/MALWAREBAZAAR_ENRICHMENT.md.
MALWAREBAZAAR_AUTH_KEY=

# ------------------------------------------- Malware dynamic typing campaign
# REQUIRED. This host is a Xen dom0: a guest escape from a live-malware trace has
# hypervisor-wide blast radius, not just VM-wide. Setting this to 1 is an explicit
# acceptance of that risk. Prefer running from an unprivileged domU instead.
MALWARE_ACCEPT_DOM0_RISK=

# REQUIRED. Staging needs root for qemu-nbd + ntfs-3g. No password is hardcoded.
MALWARE_SUDO_PW=

# Concurrent traces. Ceiling is 16: /dev/nbd0..15 caps parallel staging, and that
# binds before CPU (32 cores) or RAM (~5-6 GB per guest).
MALWARE_JOBS=16

# Seconds between guest starts. Boot is the phase that collapses under contention:
# measured boot-to-sample_start is ~300 s alone, >900 s at 20-way overlap, at which
# point every rep dies no_execution_launch_failed. 150 s keeps ~3 guests booting at
# once. Set 0 only in snapshot-resume mode, where there is no boot to serialise.
MALWARE_BOOT_STAGGER=150

# Traces per sample. Ugarte Sec V-C takes the maximum observed across reps.
MALWARE_REPS=2

# Scratch for work images and traces: 8-16 GB per trace, needs >=100 GB free.
# Must NOT be on / (61 GB free); /data has 437 GB.
MALWARE_SCRATCH=/data/malware_scratch
