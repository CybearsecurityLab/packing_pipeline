+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qemu/main-loop.h"
+#include "qemu/coroutine.h"
+#include "qemu/queue.h"
+#include "qemu/aio.h"
+#include "block/block-io.h"
+#include "block/block_int.h"
+#include "block/blkdet.h"
+#include "qapi/error.h"
+#include "system/runstate.h"
+
+#define BLKDET_DELAY_NS 100000
+
+int blkdet_sync_depth;
+
+typedef struct DetRequest {
+    Coroutine *co;
+    QEMUTimer *timer;
+    bool io_done;
+    bool parked;
+    bool immediate;
+    QLIST_ENTRY(DetRequest) next;
+} DetRequest;
+
+typedef struct BDRVBlkdetState {
+    QLIST_HEAD(, DetRequest) requests;
+    int drained;
+} BDRVBlkdetState;
+
+static int blkdet_open(BlockDriverState *bs, QDict *options, int flags,
+                       Error **errp)
+{
+    BDRVBlkdetState *s = bs->opaque;
+    int ret = bdrv_open_file_child(NULL, options, "image", bs, errp);
+
+    if (ret < 0) {
+        return ret;
+    }
+    QLIST_INIT(&s->requests);
+    s->drained = 0;
+    bs->supported_write_flags = BDRV_REQ_WRITE_UNCHANGED;
+    bs->supported_zero_flags = BDRV_REQ_WRITE_UNCHANGED;
+    return 0;
+}
+
+static int64_t coroutine_fn GRAPH_RDLOCK
+blkdet_co_getlength(BlockDriverState *bs)
+{
+    return bdrv_co_getlength(bs->file->bs);
+}
+
+static void blkdet_release(DetRequest *req)
+{
+    if (req->parked) {
+        req->parked = false;
+        aio_co_enter(qemu_get_aio_context(), req->co);
+    }
+}
+
+static void blkdet_deliver(void *opaque)
+{
+    DetRequest *req = opaque;
+    AioContext *ctx = qemu_get_aio_context();
+
+    while (!req->io_done) {
+        aio_poll(ctx, true);
+    }
+    blkdet_release(req);
+}
+
+static void coroutine_fn blkdet_arm(BlockDriverState *bs, DetRequest *req)
+{
+    BDRVBlkdetState *s = bs->opaque;
+
+    req->co = qemu_coroutine_self();
+    req->io_done = false;
+    req->parked = false;
+    req->immediate = blkdet_sync_depth > 0 || s->drained > 0 ||
+                     !runstate_is_running();
+    req->timer = NULL;
+    QLIST_INSERT_HEAD(&s->requests, req, next);
+    if (!req->immediate) {
+        req->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, blkdet_deliver, req);
+        timer_mod_ns(req->timer,
+                     qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + BLKDET_DELAY_NS);
+    }
+}
+
+static int coroutine_fn blkdet_finish(DetRequest *req, int ret)
+{
+    req->io_done = true;
+    if (!req->immediate) {
+        req->parked = true;
+        qemu_coroutine_yield();
+    }
+    if (req->timer) {
+        timer_free(req->timer);
+        req->timer = NULL;
+    }
+    QLIST_REMOVE(req, next);
+    return ret;
+}
+
+static void blkdet_drain_begin(BlockDriverState *bs)
+{
+    BDRVBlkdetState *s = bs->opaque;
+    DetRequest *req;
+    DetRequest *tmp;
+
+    s->drained++;
+    QLIST_FOREACH_SAFE(req, &s->requests, next, tmp) {
+        req->immediate = true;
+        if (req->timer) {
+            timer_del(req->timer);
+        }
+        blkdet_release(req);
+    }
+}
+
+static void blkdet_drain_end(BlockDriverState *bs)
+{
+    BDRVBlkdetState *s = bs->opaque;
+
+    s->drained--;
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+blkdet_co_preadv(BlockDriverState *bs, int64_t offset, int64_t bytes,
+                 QEMUIOVector *qiov, BdrvRequestFlags flags)
+{
+    DetRequest req;
+
+    blkdet_arm(bs, &req);
+    return blkdet_finish(&req, bdrv_co_preadv(bs->file, offset, bytes, qiov,
+                                              flags));
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+blkdet_co_pwritev(BlockDriverState *bs, int64_t offset, int64_t bytes,
+                  QEMUIOVector *qiov, BdrvRequestFlags flags)
+{
+    DetRequest req;
+
+    blkdet_arm(bs, &req);
+    return blkdet_finish(&req, bdrv_co_pwritev(bs->file, offset, bytes, qiov,
+                                               flags));
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+blkdet_co_pwrite_zeroes(BlockDriverState *bs, int64_t offset, int64_t bytes,
+                        BdrvRequestFlags flags)
+{
+    DetRequest req;
+
+    blkdet_arm(bs, &req);
+    return blkdet_finish(&req, bdrv_co_pwrite_zeroes(bs->file, offset, bytes,
+                                                     flags));
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+blkdet_co_pdiscard(BlockDriverState *bs, int64_t offset, int64_t bytes)
+{
+    DetRequest req;
+
+    blkdet_arm(bs, &req);
+    return blkdet_finish(&req, bdrv_co_pdiscard(bs->file, offset, bytes));
+}
+
+static int coroutine_fn GRAPH_RDLOCK blkdet_co_flush(BlockDriverState *bs)
+{
+    DetRequest req;
+
+    blkdet_arm(bs, &req);
+    return blkdet_finish(&req, bdrv_co_flush(bs->file->bs));
+}
+
+static BlockDriver bdrv_blkdet = {
+    .format_name            = "blkdet",
+    .instance_size          = sizeof(BDRVBlkdetState),
+    .is_filter              = true,
+
+    .bdrv_open              = blkdet_open,
+    .bdrv_child_perm        = bdrv_default_perms,
+    .bdrv_co_getlength      = blkdet_co_getlength,
+
+    .bdrv_co_preadv         = blkdet_co_preadv,
+    .bdrv_co_pwritev        = blkdet_co_pwritev,
+    .bdrv_co_pwrite_zeroes  = blkdet_co_pwrite_zeroes,
+    .bdrv_co_pdiscard       = blkdet_co_pdiscard,
+    .bdrv_co_flush          = blkdet_co_flush,
+
+    .bdrv_drain_begin       = blkdet_drain_begin,
+    .bdrv_drain_end         = blkdet_drain_end,
+};
+
+static void bdrv_blkdet_init(void)
+{
+    bdrv_register(&bdrv_blkdet);
+}
+
+block_init(bdrv_blkdet_init);
