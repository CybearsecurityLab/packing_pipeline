+typedef struct IDEDetOneshot {
+    QEMUTimer *timer;
+    QEMUBHFunc *cb;
+    void *opaque;
+} IDEDetOneshot;
+
+static void ide_det_oneshot_fire(void *opaque)
+{
+    IDEDetOneshot *shot = opaque;
+
+    timer_free(shot->timer);
+    shot->cb(shot->opaque);
+    g_free(shot);
+}
+
+static bool ide_det_schedule(QEMUBHFunc *cb, void *opaque)
+{
+    IDEDetOneshot *shot;
+
+    if (!icount_deterministic || !runstate_is_running()) {
+        return false;
+    }
+    shot = g_new(IDEDetOneshot, 1);
+    shot->cb = cb;
+    shot->opaque = opaque;
+    shot->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, ide_det_oneshot_fire, shot);
+    timer_mod_ns(shot->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    return true;
+}
